{
  "name": "rentvine-mcp-custom",
  "version": "1.3.2",
  "private": true,
  "description": "MCP server for Rentvine property management — Rentor fork of rentvine-mcp",
  "type": "module",
  "bin": {
    "rentvine-mcp": "dist/index.js",
    "rentvine-mcp-http": "dist/http.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js dist/http.js",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rentor-CA/Rentvine-MCP.git"
  },
  "homepage": "https://github.com/Rentor-CA/Rentvine-MCP#readme",
  "bugs": {
    "url": "https://github.com/Rentor-CA/Rentvine-MCP/issues"
  },
  "keywords": [
    "mcp",
    "rentvine",
    "property-management",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.21.0",
    "zipcodes": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
