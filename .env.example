# Local development only. Copy to .env and fill in.
#   cp .env.example .env
#
# .env is gitignored. Point this at a DEV Rentvine account, never production —
# the write tools (create_work_order, create_bill, update_work_order,
# upload_file) act on live data with no sandbox.
#
# Load it into your shell before starting the server:
#   set -a && source .env && set +a
#
# There is no dotenv dependency; the server reads plain environment variables.

RENTVINE_API_KEY=
RENTVINE_API_SECRET=

# Subdomain only — "acme" for acme.rentvine.com
RENTVINE_COMPANY=

# Any non-empty string is fine locally; production uses `openssl rand -hex 32`.
MCP_AUTH_TOKEN=dev-token

# Loopback + a port that will not collide with a deployed instance.
HOST=127.0.0.1
PORT=18009
